{
  "name": "prahari",
  "version": "0.3.0",
  "description": "Type-safe env vars for TypeScript with a drift-proof CLI — validated at boot, bring your own Zod/Valibot/ArkType, plus Next.js & Vite server/client guards.",
  "type": "module",
  "license": "MIT",
  "author": "Kripa Sindhu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kripa-sindhu-007/prahari.git"
  },
  "homepage": "https://prahari-azure.vercel.app",
  "bugs": {
    "url": "https://github.com/kripa-sindhu-007/prahari/issues"
  },
  "keywords": [
    "env",
    "environment-variables",
    "typescript",
    "type-safe",
    "validation",
    "dotenv",
    "config",
    "cli",
    "process.env",
    "standard-schema",
    "zod",
    "valibot",
    "arktype",
    "nextjs",
    "vite"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "next": [
        "./dist/next.d.ts"
      ],
      "vite": [
        "./dist/vite.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "prahari": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:types": "vitest --typecheck --run",
    "test:package": "pnpm build && publint && attw --pack .",
    "test:all": "pnpm test:cov && pnpm test:types && pnpm test:package",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "packageManager": "pnpm@11.23.0",
  "dependencies": {
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "arktype": "^2.2.3",
    "fast-check": "^4.9.0",
    "publint": "^0.3.24",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "valibot": "^1.4.2",
    "vitest": "^2.1.8",
    "zod": "^4.5.4"
  }
}
